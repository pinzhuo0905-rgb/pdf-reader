{
  "name": "pdf-reader",
  "version": "1.2.7",
  "description": "界面纯净、功能丰富的 PDF 阅读器：复刻 Edge 阅读器观感，内置标注、内容编辑与中英双语离线 OCR",
  "main": "src/main/main.js",
  "author": "PDF Reader contributors",
  "license": "MIT",
  "homepage": "https://github.com/pinzhuo0905-rgb/pdf-reader#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinzhuo0905-rgb/pdf-reader.git"
  },
  "bugs": {
    "url": "https://github.com/pinzhuo0905-rgb/pdf-reader/issues"
  },
  "keywords": [
    "pdf",
    "pdf-reader",
    "pdf-editor",
    "pdf-annotation",
    "electron",
    "pdfjs",
    "pdf-lib",
    "ocr",
    "offline-ocr",
    "chinese-ocr",
    "paddleocr",
    "onnxruntime",
    "desktop-app",
    "windows"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-vendor.mjs",
    "vendor": "node scripts/prepare-vendor.mjs",
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "icon:edge": "node scripts/extract-edge-icon.mjs",
    "shots": "node scripts/make-screenshots.mjs",
    "set-default": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-default-pdf.ps1",
    "test:interact": "node scripts/run-e2e.mjs test/e2e/interact.js --delay 9000",
    "test:ocr": "node scripts/run-e2e.mjs test/e2e/ocr.js --delay 16000",
    "test:tabs": "node scripts/run-e2e.mjs test/e2e/tabs.js --delay 14000",
    "test:chrome": "node scripts/run-e2e.mjs test/e2e/chrome.js --delay 7000",
    "test:regress": "node scripts/run-e2e.mjs test/e2e/regress.js --delay 14000",
    "test:save": "node scripts/run-e2e.mjs test/e2e/save.js --delay 9000",
    "test:textbox": "node scripts/run-e2e.mjs test/e2e/textbox.js --delay 9000",
    "test:eraser": "node scripts/run-e2e.mjs test/e2e/eraser.js --delay 9000",
    "test:uiv2": "node scripts/run-e2e.mjs test/e2e/uiv2.js --delay 9000",
    "test:full": "node scripts/run-e2e.mjs test/e2e/full.js --delay 12000",
    "test:uirepeat": "node scripts/run-e2e.mjs test/e2e/ui-repeat.js --delay 11000"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.pdfreader.app",
    "productName": "PDF Reader",
    "copyright": "PDF Reader contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF 文档",
          "description": "PDF 文档",
          "icon": "build/pdf-file.ico",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Reader",
      "artifactName": "PDFReader-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "menuCategory": false
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "^1.20.1"
  }
}
